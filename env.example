# Required: Neo4j Connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Required: Ollama Local Configuration (Query Agent, Graph Builder)
OLLAMA_BASE_URL=http://localhost:11434
# Compose API inference endpoint: container default; set to host.docker.internal:11434
# only when Docker should use the native macOS Ollama daemon.
OLLAMA_DOCKER_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3.5:0.8b
OLLAMA_IMAGE=grag-edge-ollama:cpu
OLLAMA_API_KEY=  # Only needed if local Ollama requires auth

# Required by current query and entity/relation extraction paths.
# P0 preserves these legacy cloud calls; local routing remains a spec conformance gap.
OLLAMA_CLOUD_URL=https://ollama.com
OLLAMA_CLOUD_MODEL=minimax-m2.7:cloud
OLLAMA_CLOUD_API_KEY=

# Required: Embedding Model for vector search
EMBEDDING_MODEL=nomic-embed-text

# Required: Qdrant Edge local memory
QDRANT_EDGE_PATH=./data/qdrant-edge

# Optional: API Authentication (for OpenWebUI)
# Leave blank for local development without auth
API_KEY=

# Optional: Model name exposed to OpenWebUI
MODEL_NAME=grag-pipeline-v1

# Optional: Server Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development

# Optional: Cloud LLM (for Context Builder / Explanation Agents)
# Leave blank to use Ollama only
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional: Context Management
CONTEXT_TOKEN_BUDGET=8192
CONTEXT_WARNING_THRESHOLD=0.80

# Optional: Retrieval Configuration
RETRIEVAL_SIMILARITY_THRESHOLD=0.75
RETRIEVAL_TOP_K=20
RETRIEVAL_MAX_HOPS=4

# Qdrant Edge embedded storage
QDRANT_EDGE_PATH=./data/qdrant-edge
EDGE_EMBEDDING_DIMENSION=768

# Fleet synchronization
QDRANT_URL=http://qdrant-server:6333
QDRANT_COLLECTION=grag_fleet_memory
QDRANT_API_KEY=
DEVICE_ID=robot-edge-001
CONNECTIVITY_INTERVAL_SECONDS=5
SYNC_INTERVAL_SECONDS=2
